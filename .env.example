DATABASE_URL=postgresql://ngb:ngb@localhost:5432/ngb

# Backend server port
PORT=8080

# Node environment
NODE_ENV=development

# Scorpio Context Broker URL
SCORPIO_URL=http://localhost:9090

# NGSI-LD API version
SCORPIO_API_VERSION=v1

# Kafka broker address (KRaft mode)
KAFKA_BROKER=localhost:9092

# Kafka topic for NGSI-LD events
KAFKA_TOPIC=ngsi-ld-events

# Frontend base URL (for API calls from browser)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Scorpio UI URL (if exposed)
NEXT_PUBLIC_SCORPIO_URL=http://localhost:9090

# Log level: debug, verbose, log, warn, error
LOG_LEVEL=log

# Enable database query logging
DATABASE_LOGGING=true

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# JWT secret (if authentication is implemented)
JWT_SECRET=your-secret-key-change-this-in-production

# Cấu hình Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=ngb
DB_PASSWORD=ngb
DB_DATABASE=ngb

#API Key cho OpenWeatherMap
OPENWEATHER_API_KEY=eb3a4947904547285aa7bdecca8cc396

# Server Nga - để lấy địa điểm từ Overpass API
# OVERPASS_URL=https://maps.mail.ru/osm/tools/overpass/api/interpreter

# Server dự phòng (Pháp)
