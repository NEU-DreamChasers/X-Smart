# =============================================================================
# X-SMART CONFIGURATION TEMPLATE (.env.example)
# Hướng dẫn deploy:
# 1. Copy file này ra file thật: cp .env.example .env
# 2. Mở file .env và điền các giá trị thật vào các chỗ có dấu <...>
# =============================================================================

# --- 1. COMMON CONFIG (Có thể giữ nguyên) ---
PORT=8080
NODE_ENV=production
LOG_LEVEL=log

# --- 2. DATABASE (Điền thông tin DB thật của bạn vào đây) ---
DB_HOST=xsmart_postgres
DB_PORT=5432
DB_USERNAME=<YOUR_DB_USERNAME>
DB_PASSWORD=<YOUR_DB_PASSWORD>
DB_DATABASE=<YOUR_DB_NAME>

# Connection String
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=postgresql://<YOUR_DB_USERNAME>:<YOUR_DB_PASSWORD>@xsmart_postgres:5432/<YOUR_DB_NAME>

# --- 3. SECURITY (BẮT BUỘC THAY ĐỔI) ---
JWT_SECRET=<CHANGE_THIS_TO_A_RANDOM_SECRET>

# IP Public của Server + Localhost
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://<YOUR_SERVER_IP>:8000

# --- 4. GOOGLE LOGIN ---
GOOGLE_CLIENT_ID=<YOUR_GOOGLE_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<YOUR_GOOGLE_CLIENT_SECRET>
GOOGLE_CALLBACK_URL=http://<YOUR_SERVER_IP>:8000/auth/google/callback

# --- 5. FRONTEND CONFIG ---
NEXT_PUBLIC_API_URL=http://<YOUR_SERVER_IP>:8000
NEXT_PUBLIC_SCORPIO_URL=http://<YOUR_SERVER_IP>:9090

# --- 6. EXTERNAL KEYS ---
OPENWEATHER_API_KEY=<YOUR_OPENWEATHER_KEY>

# --- 7. INTERNAL SERVICES ---
SCORPIO_URL=http://scorpio:9090
SCORPIO_API_VERSION=v1
KAFKA_BROKER=kafka:9092
KAFKA_TOPIC=ngsi-ld-events
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadminpassword