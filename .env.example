# --- DATABASE CONFIGURATION ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=postgresql://postgres:password@localhost:5432/x_smart_db

# --- BACKEND SERVER ---
PORT=8080
# Môi trường: 'development' | 'production' | 'test'
NODE_ENV=development
# Log level: debug, verbose, log, warn, error
LOG_LEVEL=log

# --- AUTHENTICATION & SECURITY ---
# Chuỗi bí mật để mã hóa Token (Bắt buộc thay đổi khi chạy thật)
JWT_SECRET=thay_doi_chuoi_nay_thanh_mat_khau_bi_mat_cua_ban

# Cho phép các domain này gọi API (CORS)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# --- SMART CITY INFRASTRUCTURE ---
# Scorpio Context Broker
SCORPIO_URL=http://localhost:9090
SCORPIO_API_VERSION=v1

# Kafka Broker (Message Queue)
KAFKA_BROKER=localhost:9092
KAFKA_TOPIC=ngsi-ld-events

# --- EXTERNAL SERVICES (Cần API Key riêng) ---

# OpenWeatherMap (Lấy thời tiết)
# Đăng ký tại: https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=your_openweather_api_key_here

# --- GOOGLE OAUTH2 (Đăng nhập Google) ---
# Lấy tại: https://console.cloud.google.com/apis/credentials

# Client ID (Công khai)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Client Secret (TUYỆT ĐỐI BÍ MẬT - Không commit mã thật lên Git)
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Link Callback (Phải trùng khớp với cấu hình trên Google Console)
GOOGLE_CALLBACK_URL=http://localhost:8080/auth/google/callback

# --- FRONTEND PUBLIC VARIABLES (Dành cho Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_SCORPIO_URL=http://localhost:9090

# Cấu hình Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=ngb
DB_PASSWORD=ngb
DB_DATABASE=ngb

#API Key cho OpenWeatherMap
OPENWEATHER_API_KEY=eb3a4947904547285aa7bdecca8cc396

# Server Nga - để lấy địa điểm từ Overpass API
# OVERPASS_URL=https://maps.mail.ru/osm/tools/overpass/api/interpreter

# Server dự phòng (Pháp)
# OVERPASS_URL=https://overpass.kumi.systems/api/interpreter